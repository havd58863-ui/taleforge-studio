# Normalise line endings so the repo is reproducible across Windows/Linux/macOS
* text=auto eol=lf

# Explicit text types
*.py     text eol=lf
*.html   text eol=lf
*.css    text eol=lf
*.js     text eol=lf
*.md     text eol=lf
*.txt    text eol=lf
*.yml    text eol=lf
*.yaml   text eol=lf
*.json   text eol=lf
*.toml   text eol=lf
*.ini    text eol=lf
*.cfg    text eol=lf
Dockerfile    text eol=lf
Makefile      text eol=lf
.env.example  text eol=lf

# Binary / generated assets
*.png   binary
*.jpg   binary
*.jpeg  binary
*.webp  binary
*.pdf   binary
*.zip   binary
*.ttf   binary
*.otf   binary
*.woff  binary
*.woff2 binary
*.npy   binary
*.index binary

# Keep language stats honest
*.pdf  linguist-documentation
docs/* linguist-documentation
