APP_NAME=TaleForge Studio
APP_ENV=development
SECRET_KEY=change-me-in-production
PORT=5000

# Database
DATABASE_URL=sqlite:///taleforge.db
POSTGRES_DB=taleforge
POSTGRES_USER=taleforge
POSTGRES_PASSWORD=taleforge123
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Redis
REDIS_URL=redis://localhost:6379/0

# MinIO
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=taleforge
MINIO_SECRET_KEY=taleforge123
MINIO_BUCKET=taleforge

# Kaggle
KAGGLE_USERNAME=
KAGGLE_KEY=
KAGGLE_DATASET_PATH=./secure_data/datasets

# Vector
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
VECTOR_DB_PATH=./vector_store/faiss.index
VECTOR_METADATA_PATH=./vector_store/metadata.json

# Private files
PRIVATE_DATA_DIR=./secure_data
LORA_DIR=./secure_data/loras
REFERENCE_DIR=./secure_data/references
DATASET_DIR=./secure_data/datasets
GENERATED_DIR=./secure_data/generated

# Output
OUTPUT_DIR=./output

# Product language scope (English, German, Spanish). Other packs stay in the code but are disabled.
OUTPUT_LANGUAGES=en,de,es
ALLOW_EXTRA_LANGUAGES=0

# Optional orchestration (see docs/N8N.md) — n8n is never required
N8N_ENCRYPTION_KEY=
N8N_PASSWORD=

# Hugging Face (one token powers BOTH the writer and the image engine)
# Put it in GitHub Secrets / local .env only. Never commit it.
HF_TOKEN=

# Writer (LLM) — optional. Empty = deterministic offline scaffold.
# ollama example: LLM_PROVIDER=ollama / LLM_BASE_URL=http://127.0.0.1:11434/v1 / LLM_MODEL=gemma4:12b
# huggingface example: LLM_PROVIDER=huggingface / LLM_MODEL=Qwen/Qwen2.5-72B-Instruct  (uses HF_TOKEN)
LLM_PROVIDER=
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
LLM_TIMEOUT=120
LLM_MAX_RETRIES=2
LLM_TEMPERATURE=0.8

# Image engine — optional. huggingface | a1111 | comfyui | replicate | fal | openai
IMAGE_PROVIDER=
IMAGE_BASE_URL=
IMAGE_MODEL=
IMAGE_API_KEY=
IMAGE_WORKFLOW=
IMAGE_SAMPLER=DPM++ 2M Karras
IMAGE_TIMEOUT=600

# Print upscaling (Real-ESRGAN ncnn-vulkan binary, BSD-3-Clause)
REALESRGAN_BIN=
